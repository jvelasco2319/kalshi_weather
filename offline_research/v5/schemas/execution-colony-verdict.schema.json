{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "klax-v5-execution-readiness-verdict-v1",
  "title": "V5 Execution Evidence colony readiness verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_family",
    "colony",
    "registration_sha256",
    "source_census_sha256",
    "current_evidence_audit_sha256",
    "status",
    "verdict",
    "execution_colony_gate_passed",
    "promotion_ready",
    "protected_label_access_authorized",
    "unmet_gates",
    "registered_minimum_event_window_coverage",
    "observed_promotion_grade_event_window_coverage",
    "registered_minimum_selected_trades",
    "observed_promotion_eligible_selected_trades",
    "network_used",
    "protected_final_read",
    "actual_orders_placed",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "klax-v5-execution-readiness-verdict-v1"},
    "campaign_family": {"const": "v5_four_colony_offline_verification"},
    "colony": {"const": "execution_evidence"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "verdict": {
      "enum": [
        "PROVISIONAL_EXECUTION_SUPPORTED",
        "EXECUTION_EVIDENCE_UNAVAILABLE",
        "BOOK_RECONSTRUCTION_INVALID",
        "INSUFFICIENT_EXECUTABLE_SAMPLE",
        "DATA_INTEGRITY_FAILURE"
      ]
    },
    "registration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_census_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_evidence_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_colony_gate_passed": {"type": "boolean"},
    "promotion_ready": {"type": "boolean"},
    "protected_label_access_authorized": {"const": false},
    "unmet_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "registered_minimum_event_window_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "observed_promotion_grade_event_window_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "registered_minimum_selected_trades": {"type": "integer", "minimum": 0},
    "observed_promotion_eligible_selected_trades": {"type": "integer", "minimum": 0},
    "network_used": {"const": false},
    "protected_final_read": {"const": false},
    "actual_orders_placed": {"const": false}
  }
}

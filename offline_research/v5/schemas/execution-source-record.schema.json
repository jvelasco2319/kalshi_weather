{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "klax-v5-execution-source-record-v1",
  "title": "V5 execution source capability record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "path",
    "content_sha256",
    "row_count",
    "network_used_during_census",
    "protected_final_read",
    "campaign_orders_placed",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": "klax-v5-execution-source-record-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "source_kind": {
      "enum": [
        "actual_member_order_and_fill",
        "contemporaneous_gap_free_orderbook_snapshot_and_deltas",
        "timestamped_high_frequency_full_book_with_size",
        "one_minute_candles",
        "public_trade_prints"
      ]
    },
    "path": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_count": {"type": "integer", "minimum": 0},
    "network_used_during_census": {"const": false},
    "protected_final_read": {"const": false},
    "campaign_orders_placed": {"const": false},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  }
}

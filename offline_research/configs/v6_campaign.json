  "confirmation_policy": "SEPARATE_UNTOUCHED_PERIOD_REQUIRED_V5A_HOLDOUT_RESERVED",
  "one_shot_confirmation_only": true,
  "allow_network": false,
  "allow_orders": false,
  "allow_protected_labels": false,
  "allow_credentials": false,
  "allow_live_feeds": false,
  "allow_purchases": false,
  "actual_agent_reasoning": "Named agents propose methods, precursor tests and cross-reviews; deterministic calculations are never counted as reasoning calls.",
  "binding_files": [
    "GOALS.md",
    "docs/V6_MULTI_METHOD_TOURNAMENT_GOAL.md",
    "schemas/v6-method.schema.json"
  ],
  "registration_requires_additional_bindings": [
    "finite_method_catalog_or_enumerator",
    "controller_and_evaluator_code",
    "compiler_and_exhaustion_verifier",
    "frozen_input_inventory",
    "baseline_definitions"
  ]

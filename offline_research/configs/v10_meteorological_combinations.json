{
  "schema_version": "klax-v10-meteorological-combinations-v1",
  "status": "REGISTERED_BEFORE_ADDITIONAL_INPUT_ACQUISITION",
  "scope": "exposed calendar-2025 KLAX probability development",
  "lineage": {
    "v8_strategy_freeze": "runs/v8/frozen-primary-strategy/strategy-freeze.json",
    "v8_strategy_self_sha256": "a227b8f72ad040c2411fe63d3863d1b9c9c11121c6df5fce2fadb198ea2379fd",
    "v9_protocol_freeze": "runs/v9/frozen-research-protocol/protocol-freeze.json",
    "v9_protocol_self_sha256": "b0dae199c11e753e663ce47009307570426f9b4abe0f48c9d67c94f064df4526",
    "v8_remains_unchanged": true
  },
  "development_dates": ["2025-01-05", "2025-12-31"],
  "primary_dates": ["2025-02-04", "2025-12-31"],
  "decision_time_utc": "18:00:00",
  "additional_inputs": {
    "observations": {
      "endpoint": "https://mesonet.agron.iastate.edu/cgi-bin/request/asos.py",
      "stations": ["KLAX", "KDAG"],
      "date_range": ["2025-01-05", "2025-12-31"],
      "availability_delay_minutes": 15,
      "maximum_total_bytes": 200000000
    },
    "hrrr": {
      "archive_host": "noaa-hrrr-bdp-pds.s3.amazonaws.com",
      "cycle_utc": 6,
      "lead_hours": [8, 14],
      "downloaded_fields": ["dewpoint_2m", "temperature_925hpa"],
      "reused_fields": ["temperature_2m", "total_cloud_cover", "cloud_ceiling", "wind_u_10m", "wind_v_10m", "mean_sea_level_pressure"],
      "maximum_total_bytes": 5000000000,
      "maximum_workers": 4,
      "unavailable_registered_v9_field": "temperature_950hpa",
      "registered_substitution": "temperature_925hpa_minus_temperature_2m"
    }
  },
  "feature_blocks": [
    "season",
    "forecast_marine",
    "observed_marine",
    "pressure_and_flow",
    "inversion_and_moisture",
    "ensemble_uncertainty"
  ],
  "combination_rule": {
    "include_every_subset": true,
    "subset_count": 64,
    "conditional_blend_weights": [0.25, 0.5, 0.75],
    "hierarchical_prior_strength": 12.0,
    "combination_candidate_count": 192,
    "unchanged_v8_control_count": 1,
    "total_candidate_count": 193
  },
  "fixed_feature_states": {
    "season": ["winter", "spring", "summer", "fall"],
    "forecast_marine": ["persistent_low_cloud", "morning_low_cloud_clears", "no_strong_low_cloud_signal"],
    "observed_marine": ["persistent", "cleared", "none_or_missing"],
    "pressure_and_flow": ["offshore", "neutral", "onshore"],
    "inversion_and_moisture": ["strong_moist_inversion", "other_inversion", "no_inversion_or_missing"],
    "ensemble_uncertainty": ["low", "medium", "high"]
  },
  "fixed_thresholds": {
    "observed_marine_ceiling_ft_max": 2500,
    "observed_marine_dewpoint_depression_f_max": 8,
    "offshore_coast_minus_inland_pressure_hpa_max": -2,
    "onshore_coast_minus_inland_pressure_hpa_min": 2,
    "strong_inversion_k_min": 2,
    "moist_dewpoint_depression_f_max": 8,
    "low_disagreement_f_max": 2,
    "medium_disagreement_f_max": 5
  },
  "probability_model": {
    "base": "frozen V8 vector",
    "group_condition": "feature subset plus V8 modal bracket",
    "posterior": "Dirichlet hierarchical outcome-position distribution using strictly earlier outcomes",
    "output": "(1-weight)*V8 + weight*posterior",
    "zero_probability_allowed": false
  },
  "selection_and_gates": {
    "candidate_selection_uses_market_returns": false,
    "chronological_folds": 5,
    "ranking": ["passes_all_gates", "mean_multiclass_brier", "mean_log_loss", "candidate_id"],
    "gates": {
      "brier_below_v8": true,
      "log_loss_below_v8": true,
      "minimum_brier_improving_folds": 4,
      "minimum_log_loss_improving_folds": 4,
      "modal_accuracy_may_not_decline": true,
      "no_zero_probability_outcomes": true,
      "paired_seven_day_block_bootstrap_upper_95_below_zero_brier": true,
      "paired_seven_day_block_bootstrap_upper_95_below_zero_log_loss": true
    },
    "multiple_comparison_report_required": true,
    "development_only": true
  },
  "stopping_rule": "evaluate the complete 193-candidate catalog exactly once and report favorable or unfavorable results",
  "safety": {
    "offline_scoring_only": true,
    "paper_orders_allowed": false,
    "live_orders_allowed": false,
    "current_or_live_market_feeds_allowed": false,
    "claims_of_untouched_confirmation_allowed": false
  }
}

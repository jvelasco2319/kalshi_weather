{
  "schema_version": "v5b-research-campaign-v1",
  "max_epochs": 8,
  "max_unique_candidates": 160,
  "wall_seconds": 7200,
  "max_proposals_per_colony": 4,
  "population_size": 8,
  "stagnant_epochs_before_agent_review": 2,
  "minimum_selected_days": 30,
  "minimum_realized_return": 0.1,
  "minimum_expected_return": 0.1,
  "minimum_positive_folds": 4,
  "minimum_worst_fold_return": -0.1,
  "minimum_evidence_quality": 0.65,
  "stress_cents": 2,
  "require_positive_stress": true,
  "require_positive_best_day_removed": true,
  "require_brier_no_worse_than_baseline": true,
  "confirmation_policy": "SEPARATE_UNTOUCHED_PERIOD_REQUIRED_V5A_HOLDOUT_RESERVED",
  "allow_protected_labels": false,
  "allow_network": false,
  "allow_orders": false,
  "actual_agent_reasoning": "Codex research packets authored and independently reviewed between epochs; deterministic execution is not itself agent reasoning"
}

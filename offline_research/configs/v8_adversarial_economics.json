{
  "schema_version": "v8-adversarial-economics-config-v1",
  "forecast": {
    "minimum_dates": 120,
    "minimum_better_folds": 4,
    "minimum_mean_true_bracket_probability": 0.16666666666666666,
    "require_brier_better_than_uniform": true,
    "require_log_loss_better_than_uniform": true,
    "require_prequential_climatology_control": true,
    "require_zero_probability_outcomes": 0
  },
  "economics": {
    "minimum_selected_days": 40,
    "minimum_grade_a_days": 30,
    "minimum_aggregate_return": 0.1,
    "minimum_expected_return": 0.1,
    "minimum_positive_folds": 4,
    "minimum_worst_fold_return": -0.1,
    "stress_cents": 2,
    "require_positive_bootstrap_lower_bound": true,
    "require_positive_best_day_removed": true,
    "require_exact_historical_fees": true,
    "require_exact_event_rules": true,
    "require_statistically_untouched_period": true,
    "promotion_execution_tier": "grade_a_execution_aware_simulation"
  },
  "claim_policy": {
    "grade_b_or_b_plus_are_verified_fills": false,
    "grade_a_is_an_observed_account_fill": false,
    "historical_settlement_return_is_realized_account_return": false,
    "paper_orders_allowed": false,
    "live_orders_allowed": false
  }
}

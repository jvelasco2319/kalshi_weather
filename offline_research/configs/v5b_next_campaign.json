{
  "schema_version": "v5b-next-weather-campaign-v1",
  "max_epochs": 4,
  "max_unique_candidates": 24,
  "wall_seconds": 7200,
  "max_proposals_per_colony": 6,
  "population_size": 6,
  "stagnant_epochs_before_agent_review": 2,
  "minimum_selected_days": 30,
  "minimum_realized_return": 0.1,
  "minimum_expected_return": 0.1,
  "minimum_positive_folds": 4,
  "minimum_worst_fold_return": -0.1,
  "minimum_evidence_quality": 0.65,
  "stress_cents": 2,
  "require_positive_stress": true,
  "require_positive_best_day_removed": true,
  "require_brier_no_worse_than_baseline": true,
  "confirmation_policy": "SEPARATE_UNTOUCHED_PERIOD_REQUIRED_V5A_HOLDOUT_RESERVED",
  "allow_protected_labels": false,
  "allow_network": false,
  "allow_orders": false,
  "actual_agent_reasoning": "Codex research packets authored and independently reviewed between epochs; deterministic execution is not itself agent reasoning",
  "research_backend": "weather_v1",
  "binding_files": [
    "docs/V5B_NEXT_RESEARCH_PROTOCOL.md",
    "scripts/control_v5b_next_campaign.ps1",
    "reports/v5b-next-weather-feature-audit.md"
  ],
  "calibration_reference": "inherited_calibrated_probabilities_on_identical_44_scoring_dates",
  "scoring_date_policy": "fixed_first20_warmup_then_all44_development_dates",
  "predictive_families": 6,
  "fixed_policy_arms": 4,
  "prior_development_exposure": "V5A repeated search and V5B101 specifications; no confirmation independence"
}

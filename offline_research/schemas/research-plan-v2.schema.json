{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/klax/research-plan-v2.schema.json",
  "title": "KLAX bounded research plan V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "colony",
    "stage",
    "model_family",
    "gfs_weight",
    "bias_operator",
    "spread_operator",
    "spread_scale",
    "disagreement_coefficient",
    "calibration_operator",
    "entry_threshold",
    "allowed_sides",
    "parent_hypothesis_ids"
  ],
  "properties": {
    "plan_version": {"const": "klax-research-plan-v2"},
    "colony": {
      "enum": [
        "forecast_ensemble",
        "lax_meteorology",
        "observations_measurement",
        "probability_calibration",
        "market_execution",
        "adversarial_alternatives"
      ]
    },
    "stage": {
      "enum": [
        "forecast_skill",
        "probability_calibration",
        "market_information",
        "economic_simulation"
      ]
    },
    "model_family": {"const": "gaussian_blend"},
    "gfs_weight": {"enum": [0.0, 0.25, 0.5, 0.75, 1.0]},
    "bias_operator": {"enum": ["global", "monthly_shrinkage", "seasonal_harmonic"]},
    "spread_operator": {"enum": ["global", "monthly_shrinkage", "disagreement"]},
    "spread_scale": {"enum": [0.85, 1.0, 1.15, 1.3]},
    "disagreement_coefficient": {"enum": [0.0, 0.25, 0.5]},
    "calibration_operator": {"const": "gaussian_integer_interval"},
    "entry_threshold": {"enum": [0.10, 0.15, 0.20, 0.30]},
    "allowed_sides": {"enum": ["BOTH", "YES", "NO"]},
    "parent_hypothesis_ids": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}
    }
  }
}

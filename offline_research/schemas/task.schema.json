{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/klax-lab/task.schema.json",
  "title": "Offline Kalshi research task accepted by the manual worker controller",
  "description": "Storage and dispatch contract. Python additionally checks database references, budgets, permissions, artifact hashes, independent authorship, and transitions. This schema does not provide process isolation or call an LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "campaign_id", "idempotency_key", "epoch", "track", "role", "question", "permitted_inputs", "prohibited_inputs", "allowed_outputs", "success_condition", "failure_condition"],
  "properties": {
    "task_id": {"$ref": "#/$defs/text"},
    "campaign_id": {"$ref": "#/$defs/text"},
    "idempotency_key": {"$ref": "#/$defs/text"},
    "epoch": {"type": "integer", "minimum": 1},
    "track": {"type": "string", "pattern": "^R(0[1-9]|[12][0-9]|3[0-6])$"},
    "role": {"enum": ["explorer", "implementer", "critic", "replicator", "synthesizer", "auditor"]},
    "question": {"$ref": "#/$defs/text"},
    "permitted_inputs": {"$ref": "#/$defs/textList"},
    "prohibited_inputs": {"$ref": "#/$defs/textList"},
    "allowed_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "success_condition": {"$ref": "#/$defs/text"},
    "failure_condition": {"$ref": "#/$defs/text"},
    "dependencies": {"$ref": "#/$defs/textList", "default": []},
    "hypothesis_id": {"type": ["string", "null"], "minLength": 1, "default": null},
    "source_evidence_ids": {"$ref": "#/$defs/textList", "default": []},
    "runtime_seconds": {"type": "integer", "minimum": 1, "default": 300},
    "token_limit": {"type": "integer", "minimum": 0, "default": 0},
    "paid_limit_micros": {"type": "integer", "minimum": 0, "default": 0},
    "experiment_limit": {"type": "integer", "minimum": 0, "default": 1}
  },
  "allOf": [{"if": {"properties": {"role": {"enum": ["critic", "replicator"]}}}, "then": {"required": ["source_evidence_ids"], "properties": {"source_evidence_ids": {"minItems": 1}}}}],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "textList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens", "compute_seconds", "paid_micros", "experiments"],
      "properties": {
        "tokens": {"type": "integer", "minimum": 0},
        "compute_seconds": {"type": "integer", "minimum": 0},
        "paid_micros": {"type": "integer", "minimum": 0},
        "experiments": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "claims", "evidence", "experiments", "limitations", "next_steps"],
      "properties": {
        "status": {"enum": ["supported", "no_improvement", "insufficient_data", "invalidated", "completed"]},
        "claims": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "kind", "evidence_ids"],
          "properties": {"text": {"$ref": "#/$defs/text"}, "kind": {"enum": ["finding", "speculation"]}, "evidence_ids": {"$ref": "#/$defs/textList"}},
          "allOf": [{"if": {"properties": {"kind": {"const": "finding"}}}, "then": {"properties": {"evidence_ids": {"minItems": 1}}}}]
        }},
        "evidence": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_id", "path", "sha256", "kind", "experiment_id"],
          "properties": {"evidence_id": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}, "kind": {"$ref": "#/$defs/text"}, "experiment_id": {"type": ["string", "null"], "minLength": 1}}
        }},
        "experiments": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["experiment_id", "code_sha256", "dataset_sha256", "parameters", "metrics", "synthetic"],
          "properties": {"experiment_id": {"$ref": "#/$defs/text"}, "code_sha256": {"$ref": "#/$defs/sha256"}, "dataset_sha256": {"$ref": "#/$defs/sha256"}, "parameters": {"type": "object"}, "metrics": {"type": "object", "additionalProperties": {"type": "number"}}, "synthetic": {"type": "boolean"}}
        }},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "next_steps": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/klax/research-plan-v3.schema.json",
  "title": "KLAX bounded research plan V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version", "colony", "stage", "data_bundle_version", "data_bundle_sha256",
    "settlement_source", "settlement_target", "settlement_timezone", "contract_mapping",
    "forecast_source_set", "feature_set", "regime_model", "minimum_regime_training_days",
    "probability_family", "calibration_operator", "market_residual_model",
    "abstention_operator", "decision_time_utc",
    "market_snapshot_rule", "fill_rule", "entry_threshold", "allowed_sides",
    "uncertainty_buffer", "maximum_interval_width_f", "minimum_candle_volume",
    "maximum_price_age_minutes", "maximum_spread_cents", "entry_price_floor_cents",
    "entry_price_ceiling_cents", "maximum_positions_per_event", "lineage_operator",
    "parent_hypothesis_ids", "parent_plan_sha256s"
  ],
  "properties": {
    "plan_version": {"const": "klax-research-plan-v3"},
    "colony": {"enum": ["settlement_measurement", "local_weather", "ensemble_probability", "market_behavior", "execution_abstention", "adversarial_alternatives"]},
    "stage": {"enum": ["forecast_skill", "probability_calibration", "market_information", "economic_simulation"]},
    "data_bundle_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "data_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "settlement_source": {"const": "nws_clilax_final"},
    "settlement_target": {"const": "daily_max_integer_f"},
    "settlement_timezone": {"const": "America/Los_Angeles"},
    "contract_mapping": {"const": "kalshi_interval_bounds_v1"},
    "forecast_source_set": {"enum": ["gfs_nbm", "gfs_nbm_hrrr", "gefs", "gfs_nbm_hrrr_gefs", "gefs_summary", "hrrr_gefs_summary", "gfs_nbm_hrrr_gefs_summary"]},
    "feature_set": {"enum": ["temperature_only", "intraday_station", "marine_layer", "full_local_weather"]},
    "regime_model": {"enum": ["pooled", "calendar_month", "marine_layer_classifier", "coastal_synoptic_classifier"]},
    "minimum_regime_training_days": {"enum": [30, 60, 90]},
    "probability_family": {"enum": ["gaussian_blend", "empirical_ensemble", "quantile_brackets", "ordered_logistic", "gaussian_mixture"]},
    "calibration_operator": {"enum": ["none", "gaussian_integer_interval", "isotonic_bracket", "beta_bracket"]},
    "market_residual_model": {"enum": ["none", "regularized_logit"]},
    "abstention_operator": {"enum": ["fixed_uncertainty_buffer", "split_conformal"]},
    "decision_time_utc": {"enum": ["09:00", "12:00", "15:00", "18:00"]},
    "market_snapshot_rule": {"const": "last_completed_one_minute_candle_at_or_before_decision"},
    "fill_rule": {"const": "observed_ask_or_conservative_proxy"},
    "entry_threshold": {"enum": [0.10, 0.15, 0.20, 0.30]},
    "allowed_sides": {"enum": ["BOTH", "YES", "NO"]},
    "uncertainty_buffer": {"enum": [0.0, 0.02, 0.05, 0.10]},
    "maximum_interval_width_f": {"enum": [4.0, 6.0, 8.0, 12.0]},
    "minimum_candle_volume": {"enum": [0, 10, 25, 50]},
    "maximum_price_age_minutes": {"enum": [1, 5, 15, 60]},
    "maximum_spread_cents": {"enum": [5, 10, 15, 25]},
    "entry_price_floor_cents": {"enum": [5, 10, 15, 20]},
    "entry_price_ceiling_cents": {"enum": [80, 85, 90, 95]},
    "maximum_positions_per_event": {"const": 1},
    "lineage_operator": {"enum": ["seed", "continuation", "fork", "combination", "alternative"]},
    "parent_hypothesis_ids": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}},
    "parent_plan_sha256s": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "allOf": [
    {"if": {"properties": {"probability_family": {"const": "empirical_ensemble"}}}, "then": {"properties": {"forecast_source_set": {"enum": ["gefs", "gfs_nbm_hrrr_gefs"]}}}},
    {"if": {"properties": {"probability_family": {"const": "gaussian_blend"}}}, "then": {"properties": {"calibration_operator": {"enum": ["gaussian_integer_interval", "isotonic_bracket", "beta_bracket"]}}}},
    {"if": {"properties": {"calibration_operator": {"const": "gaussian_integer_interval"}}}, "then": {"properties": {"probability_family": {"const": "gaussian_blend"}}}},
    {"if": {"properties": {"regime_model": {"const": "marine_layer_classifier"}}}, "then": {"properties": {"feature_set": {"enum": ["marine_layer", "full_local_weather"]}}}},
    {"if": {"properties": {"regime_model": {"const": "coastal_synoptic_classifier"}}}, "then": {"properties": {"feature_set": {"const": "full_local_weather"}}}},
    {"if": {"properties": {"feature_set": {"enum": ["marine_layer", "full_local_weather"]}}}, "then": {"properties": {"forecast_source_set": {"enum": ["gfs_nbm_hrrr", "gefs", "gfs_nbm_hrrr_gefs", "gefs_summary", "hrrr_gefs_summary", "gfs_nbm_hrrr_gefs_summary"]}}}},
    {"if": {"properties": {"feature_set": {"enum": ["intraday_station", "marine_layer", "full_local_weather"]}}}, "then": {"properties": {"decision_time_utc": {"enum": ["12:00", "15:00", "18:00"]}}}},
    {"if": {"properties": {"lineage_operator": {"const": "seed"}}}, "then": {"properties": {"parent_hypothesis_ids": {"maxItems": 0}, "parent_plan_sha256s": {"maxItems": 0}}}},
    {"if": {"properties": {"lineage_operator": {"enum": ["continuation", "fork"]}}}, "then": {"properties": {"parent_hypothesis_ids": {"minItems": 1, "maxItems": 1}, "parent_plan_sha256s": {"minItems": 1, "maxItems": 1}}}},
    {"if": {"properties": {"lineage_operator": {"const": "combination"}}}, "then": {"properties": {"parent_hypothesis_ids": {"minItems": 2}, "parent_plan_sha256s": {"minItems": 2}}}},
    {"if": {"properties": {"lineage_operator": {"const": "alternative"}}}, "then": {"properties": {"parent_hypothesis_ids": {"maxItems": 1}, "parent_plan_sha256s": {"maxItems": 1}}}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klax.local/schemas/frozen-development-label-v3.schema.json",
  "title": "KLAX V3 frozen development evaluation label row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "partition", "data_role", "climate_date", "event_ticker",
    "reported_high_f", "contracts", "settlement_source_sha256", "label_role"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "partition": {"const": "selection"},
    "data_role": {"enum": ["development_calibration_label", "development_evaluation_label"]},
    "climate_date": {"type": "string", "format": "date"},
    "event_ticker": {"type": "string", "pattern": "^KXHIGHLAX-"},
    "reported_high_f": {"type": "integer", "minimum": -100, "maximum": 150},
    "contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ticker", "yes_outcome"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^KXHIGHLAX-"},
          "yes_outcome": {"type": "integer", "enum": [0, 1]}
        }
      }
    },
    "settlement_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label_role": {"const": "evaluation_only_not_discovery_feature"}
  }
}

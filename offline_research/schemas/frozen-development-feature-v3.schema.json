{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klax.local/schemas/frozen-development-feature-v3.schema.json",
  "title": "KLAX V3 frozen development feature row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "partition", "data_role", "climate_date", "event_ticker",
    "decision_time_utc", "decision_at", "contracts", "observations",
    "forecasts", "as_of_join_validated", "contains_settlement_label"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "partition": {"const": "selection"},
    "data_role": {"enum": ["development_calibration", "development_evaluation"]},
    "climate_date": {"type": "string", "format": "date"},
    "event_ticker": {"type": "string", "pattern": "^KXHIGHLAX-"},
    "decision_time_utc": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "decision_at": {"type": "string", "format": "date-time"},
    "contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ticker", "interval", "market"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^KXHIGHLAX-"},
          "interval": {"type": "object"},
          "market": {
            "type": "object", "additionalProperties": false,
            "required": ["availability_basis", "latest_completed_candle", "public_trades_last_60_minutes"],
            "properties": {
              "availability_basis": {"const": "completed_one_minute_bar_end_timestamp"},
              "latest_completed_candle": {"type": "object"},
              "public_trades_last_60_minutes": {
                "type": "object", "additionalProperties": false,
                "required": ["window_start_exclusive", "window_end_inclusive", "trade_count", "quantity_contracts", "latest_trade", "source_sha256s"],
                "properties": {
                  "window_start_exclusive": {"type": "string", "format": "date-time"},
                  "window_end_inclusive": {"type": "string", "format": "date-time"},
                  "trade_count": {"type": "integer", "minimum": 0},
                  "quantity_contracts": {"type": "string"},
                  "latest_trade": {"type": ["object", "null"]},
                  "source_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true}
                }
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["station", "observed_at", "available_at", "source_sha256", "as_of_validated"],
        "properties": {"as_of_validated": {"const": true}}
      }
    },
    "forecasts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model", "field_id", "member_id", "initialized_at", "available_at", "valid_at", "value", "is_missing", "source_sha256", "as_of_validated"],
        "properties": {"as_of_validated": {"const": true}, "is_missing": {"type": "boolean"}}
      }
    },
    "as_of_join_validated": {"const": true},
    "contains_settlement_label": {"const": false}
  }
}

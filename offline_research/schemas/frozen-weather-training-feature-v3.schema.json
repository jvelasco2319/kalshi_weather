{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klax.local/schemas/frozen-weather-training-feature-v3.schema.json",
  "title": "KLAX V3 frozen weather-training feature row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "partition", "data_role", "climate_date",
    "decision_time_utc", "decision_at", "observations", "forecasts",
    "as_of_join_validated", "contains_market_evidence", "contains_settlement_label"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "partition": {"const": "weather_training"},
    "data_role": {"const": "weather_model_training"},
    "climate_date": {"type": "string", "format": "date"},
    "decision_time_utc": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "decision_at": {"type": "string", "format": "date-time"},
    "observations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["station", "observed_at", "available_at", "source_sha256", "as_of_validated"],
        "properties": {"as_of_validated": {"const": true}}
      }
    },
    "forecasts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model", "field_id", "member_id", "initialized_at", "available_at", "valid_at", "value", "is_missing", "source_sha256", "as_of_validated"],
        "properties": {"as_of_validated": {"const": true}, "is_missing": {"type": "boolean"}}
      }
    },
    "as_of_join_validated": {"const": true},
    "contains_market_evidence": {"const": false},
    "contains_settlement_label": {"const": false}
  }
}

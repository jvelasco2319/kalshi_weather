{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:klax:v6:method:v1",
  "title": "V6 preregistered method record",
  "description": "Interchange contract only. Runtime must verify catalog membership, capability prerequisites, executable grammar, source hashes, cohort, fingerprint and budget. Schema validation alone does not authorize evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method_id",
    "group",
    "title",
    "causal_rationale",
    "counter_hypothesis",
    "assumptions",
    "input_capabilities",
    "precursor_tests",
    "falsification_tests",
    "executable",
    "parent_method_ids",
    "origin",
    "proposing_agent",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "klax-v6-method-v1"
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "enum": [
        "conditional_uncertainty",
        "incremental_market_information",
        "decision_execution",
        "null_adversarial"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "causal_rationale": {
      "type": "string",
      "minLength": 1
    },
    "counter_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "precursor_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "question",
          "baseline_id",
          "metric",
          "failure_criterion",
          "chronology_policy"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "baseline_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "failure_criterion": {
            "type": "string",
            "minLength": 1
          },
          "chronology_policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "falsification_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "language_version",
        "catalog_entry_id",
        "parameters"
      ],
      "properties": {
        "backend_id": {
          "type": "string",
          "minLength": 1
        },
        "language_version": {
          "type": "string",
          "minLength": 1
        },
        "catalog_entry_id": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "description": "Must independently match the finite registered compiler grammar; no arbitrary code/plugin execution is implied.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        }
      }
    },
    "parent_method_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origin": {
      "enum": [
        "agent_authored",
        "agent_cross_pollination",
        "preregistered_null",
        "deterministic_ablation"
      ]
    },
    "proposing_agent": {
      "type": "string",
      "minLength": 1
    },
    "round_proposed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "status": {
      "enum": [
        "proposed",
        "admitted",
        "blocked",
        "evaluated",
        "canonical_duplicate",
        "rejected"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "behavioral_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "data_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "blocked_prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independent_review_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_ablation_parent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

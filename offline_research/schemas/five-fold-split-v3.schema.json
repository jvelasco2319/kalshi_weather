{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klax.local/schemas/five-fold-split-v3.schema.json",
  "title": "KLAX V3 fixed calibration prefix and five scored evaluation folds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component", "dataset_id", "partition", "method",
    "training_rule", "protected_final_included", "calibration_dates",
    "calibration_dates_sha256", "evaluation_dates",
    "evaluation_dates_sha256", "folds", "folds_id"
  ],
  "properties": {
    "schema_version": {"const": "klax-v3-five-contiguous-folds-v1"},
    "component": {"const": "five_fold_split"},
    "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition": {"const": "selection"},
    "method": {"type": "string"},
    "training_rule": {"type": "string"},
    "protected_final_included": {"const": false},
    "calibration_dates": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {"type": "string", "format": "date"}, "uniqueItems": true
    },
    "calibration_dates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_dates": {
      "type": "array", "minItems": 5,
      "items": {"type": "string", "format": "date"}, "uniqueItems": true
    },
    "evaluation_dates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "folds": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "fold_id", "fold_index", "start_date", "end_date", "day_count",
          "dates", "dates_sha256", "permitted_calibration_dates",
          "permitted_calibration_dates_sha256"
        ],
        "properties": {
          "fold_id": {"type": "string"},
          "fold_index": {"type": "integer", "minimum": 1, "maximum": 5},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "day_count": {"type": "integer", "minimum": 1},
          "dates": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "date"}, "uniqueItems": true},
          "dates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "permitted_calibration_dates": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"type": "string", "format": "date"}, "uniqueItems": true},
          "permitted_calibration_dates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "folds_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

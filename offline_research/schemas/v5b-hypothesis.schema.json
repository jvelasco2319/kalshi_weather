{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:klax:v5b:hypothesis:v1",
  "title": "V5B executable normalized hypothesis",
  "description": "Structural interchange schema for normalized executable records. Runtime additionally verifies fingerprint, price order and evaluator bounds; the frozen controller does not load this schema. Blocked research records intentionally do not conform.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "colony",
    "title",
    "causal_rationale",
    "assumptions",
    "falsification_tests",
    "data_requirements",
    "parameters",
    "parent_ids",
    "origin"
  ],
  "properties": {
    "schema": {
      "const": "klax-v5b-hypothesis-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "colony": {
      "enum": [
        "forecast_probability",
        "timing_execution",
        "contract_relative_value",
        "robustness_adversary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "causal_rationale": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsification_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "probability_power": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "uniform_blend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probability_haircut": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allowed_grades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B_PLUS",
              "B"
            ]
          }
        },
        "allowed_sides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "YES",
              "NO"
            ]
          }
        },
        "minimum_price_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "maximum_price_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "maximum_spread_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "minimum_expected_net_return": {
          "type": "number",
          "minimum": 0
        },
        "additional_adverse_price_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "neighbor_smoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tail_policy": {
          "type": "string",
          "enum": [
            "all",
            "interior",
            "tails"
          ]
        },
        "maximum_entropy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_probability_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selection_mode": {
          "type": "string",
          "enum": [
            "expected_return",
            "expected_profit"
          ]
        },
        "calibration": {
          "type": "string",
          "enum": [
            "none",
            "expanding_rank_frequency"
          ]
        },
        "calibration_strength": {
          "type": "number",
          "minimum": 0
        },
        "calibration_min_days": {
          "type": "integer",
          "minimum": 10
        },
        "probability_source": {
          "type": "string",
          "enum": [
            "calibrated",
            "raw"
          ]
        }
      },
      "additionalProperties": false
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "executable"
    }
  },
  "additionalProperties": true
}
